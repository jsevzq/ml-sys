# Copiar a .env y completar. El .env no se versiona.
#
# Para probar el proyecto alcanza con DB_PASSWORD y JWT_SECRET: el seed de demo
# (npm run seed:demo) carga datos ficticios y no necesita credenciales de
# Mercado Libre. Las de ML sólo hacen falta para sincronizar una cuenta real.

# Puerto en el que escucha la API.
PORT=3000

# Orígenes autorizados por CORS, separados por coma. Vacío acepta cualquier
# origen de bucle local (localhost, 127.0.0.1 o ::1) en cualquier puerto, que es
# lo que hace falta en desarrollo: Vite cambia de puerto solo si el 5173 está
# ocupado. Al desplegar, declarar acá el dominio del frontend.
CORS_ORIGINS=

# Postgres. El puerto es el que publica docker-compose.yml hacia afuera.
DB_HOST=localhost
DB_PORT=2345
DB_USERNAME=nest_admin
DB_PASSWORD=
DB_NAME=mh

# Imprime cada consulta SQL con sus parámetros. Sólo para depurar.
DB_LOGGING=false

# Firma de los JWT de la app. Cualquier string largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotarlo invalida todas las sesiones abiertas.
JWT_SECRET=

# Aplicación de Mercado Libre: https://developers.mercadolibre.com.uy/devcenter
# ML_REDIRECT_URI tiene que coincidir exactamente con la registrada en la app.
# Mientras no haya dominio queda en https://local y la vinculación se completa
# pegando a mano la URL de retorno en /connect-ml.
ML_CLIENT_ID=
ML_REDIRECT_URI=https://local
ML_CLIENT_SECRET=
